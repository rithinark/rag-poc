# ==============================================================================
# Enterprise RAG Service Environment Configuration Template
# Copy this file to .env and configure your secret credentials:
# cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Required for ChatGoogleGenerativeAI ReAct Agent)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (Qdrant)
QDRANT_LOCATION=:memory:
QDRANT_COLLECTION=secure_knowledge_base

# Cryptographic HMAC Tamper-Proof Signing Secret
HMAC_SECRET_KEY=super-secure-production-hmac-key-256bit!!

# FastMCP Protocol Settings
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=sse

# JWT Authentication
JWT_SECRET_KEY=super-secret-enterprise-hmac-key-256bit!!
